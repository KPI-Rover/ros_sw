<?xml version="1.0"?>
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find kpi_rover_worlds)/common/xacro/walls.xacro"/>

  <xacro:property name="arch_color" value="${[0.55, 0.42, 0.3]}"/>

  <!--
    Opening in a wall segment 'span' long along local X at (x, y) rotated by
    'yaw': posts on both sides leave a 'width' wide opening, and a lintel above
    'height' closes it up to 'wall_height'. 'height' 0 makes a doorway without
    a lintel. 'view' is the GUI view of its parts, see solid_box; as marking,
    the lintel is a thin line across the opening. 'material' is a wall
    material from walls.yaml, or 'contrast' for a plain color that stands out
    from the walls.
  -->
  <xacro:macro name="arch" params="name x y yaw span width height wall_height:=0.5 thickness:=0.05 view:=solid material:=contrast">
    <xacro:property name="post" value="${(span - width) / 2}"/>
    <xacro:property name="arch_rgb" value="${arch_color if material == 'contrast' else walls_cfg[material]['color']}"/>
    <xacro:property name="arch_texture" value="${'' if material == 'contrast' else walls_cfg[material]['texture']}"/>
    <xacro:property name="post_mesh" value="${wall_meshes.get('%.4fx%.4fx%.4f@%.4f/%s' % (post, thickness, wall_height, 0, material), '')}"/>
    <xacro:property name="lintel_mesh" value="${wall_meshes.get('%.4fx%.4fx%.4f@%.4f/%s' % (width, thickness, wall_height - height, height, material), '')}"/>
    <model name="${name}">
      <static>true</static>
      <pose>${x} ${y} 0 0 0 ${yaw}</pose>
      <link name="link">
        <xacro:if value="${post > 0}">
          <xacro:solid_box name="post_left" x="${-(width + post) / 2}" y="0" z="${wall_height / 2}"
              sx="${post}" sy="${thickness}" sz="${wall_height}" color="${arch_rgb}" texture="${arch_texture}" mesh="${post_mesh}" view="${view}"/>
          <xacro:solid_box name="post_right" x="${(width + post) / 2}" y="0" z="${wall_height / 2}"
              sx="${post}" sy="${thickness}" sz="${wall_height}" color="${arch_rgb}" texture="${arch_texture}" mesh="${post_mesh}" view="${view}"/>
        </xacro:if>
        <xacro:if value="${height > 0}">
          <xacro:solid_box name="lintel" x="0" y="0" z="${(height + wall_height) / 2}"
              sx="${width}" sy="${thickness}" sz="${wall_height - height}" color="${arch_rgb}" texture="${arch_texture}" mesh="${lintel_mesh}" view="${view}" footprint_scale="0.3"/>
        </xacro:if>
      </link>
    </model>
  </xacro:macro>

</sdf>
