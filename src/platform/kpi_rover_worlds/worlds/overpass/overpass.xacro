<?xml version="1.0"?>
<!--
  Overpass with smooth ramps, optional rails and its own marking.

  Usage:
    <xacro:overpass name="bridge" cx="0" cy="0" yaw="0.5" style="white" offsets="${[0]}"/>
-->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find kpi_rover_worlds)/common/xacro/floor.xacro"/>
  <xacro:include filename="$(find kpi_rover_worlds)/common/xacro/marking.xacro"/>
  <xacro:include filename="$(find kpi_rover_worlds)/common/xacro/walls.xacro"/>

  <xacro:property name="rail_color" value="${[1.0, 0.8, 0.0]}"/>

  <!-- Marking lines i..len(offsets)-1 from (x1, offset, z1) to (x2, offset, z2). -->
  <xacro:macro name="offset_marking_lines" params="name i offsets x1 z1 x2 z2 style width fine:=False">
    <xacro:marking_line name="${name}_${i}" x1="${x1}" y1="${offsets[i]}" z1="${z1}" x2="${x2}" y2="${offsets[i]}" z2="${z2}"
        style="${style}" width="${width}" fine="${fine}"/>
    <xacro:if value="${i + 1 &lt; len(offsets)}">
      <xacro:offset_marking_lines name="${name}" i="${i + 1}" offsets="${offsets}" x1="${x1}" z1="${z1}" x2="${x2}" z2="${z2}"
          style="${style}" width="${width}" fine="${fine}"/>
    </xacro:if>
  </xacro:macro>

  <!--
    Pieces k..n-1 of an overpass ramp profile, from local X = 'dir * foot'
    (ground) towards the deck by 'length'; 'dir' is -1 for the entry ramp and
    1 for the exit ramp. Emits rails ('rails') or marking lines ('offsets').
  -->
  <xacro:macro name="ramp_pieces" params="name k n dir foot length height rails:=False rail_y:=0 rail_height:=0 rail_width:=0
                                           offsets:=${[]} style:=white marking_width:=0.05">
    <xacro:property name="xa" value="${dir * (foot - length * k / n)}"/>
    <xacro:property name="xb" value="${dir * (foot - length * (k + 1) / n)}"/>
    <xacro:property name="za" value="${height * (1 - cos(pi * k / n)) / 2}"/>
    <xacro:property name="zb" value="${height * (1 - cos(pi * (k + 1) / n)) / 2}"/>

    <xacro:if value="${rails}">
      <xacro:property name="piece_length" value="${sqrt((xb - xa) ** 2 + (zb - za) ** 2)}"/>
      <xacro:property name="piece_pitch" value="${-atan2(zb - za, xb - xa)}"/>
      <!-- Rails are lengthened by half their height so they have no gaps where the slope changes. -->
      <xacro:solid_box name="${name}_rail_left_${k}" x="${(xa + xb) / 2}" y="${rail_y}" z="${(za + zb) / 2 + rail_height / 2}"
          sx="${piece_length + rail_height / 2}" sy="${rail_width}" sz="${rail_height}" color="${rail_color}" pitch="${piece_pitch}"/>
      <xacro:solid_box name="${name}_rail_right_${k}" x="${(xa + xb) / 2}" y="${-rail_y}" z="${(za + zb) / 2 + rail_height / 2}"
          sx="${piece_length + rail_height / 2}" sy="${rail_width}" sz="${rail_height}" color="${rail_color}" pitch="${piece_pitch}"/>
    </xacro:if>
    <xacro:if value="${len(offsets) > 0}">
      <xacro:offset_marking_lines name="${name}_marking_${k}" i="0" offsets="${offsets}" x1="${xa}" z1="${za}" x2="${xb}" z2="${zb}"
          style="${style}" width="${marking_width}" fine="True"/>
    </xacro:if>

    <xacro:if value="${k + 1 &lt; n}">
      <xacro:ramp_pieces name="${name}" k="${k + 1}" n="${n}" dir="${dir}" foot="${foot}" length="${length}" height="${height}"
          rails="${rails}" rail_y="${rail_y}" rail_height="${rail_height}" rail_width="${rail_width}"
          offsets="${offsets}" style="${style}" marking_width="${marking_width}"/>
    </xacro:if>
  </xacro:macro>

  <!--
    Overpass along local X centered at (cx, cy) and rotated by 'yaw': a deck at
    'height' with a smooth ramp at each end, optional rails along both edges
    and marking lines at lateral 'offsets' from its axis. 'width' is the full
    width including rails, 'max_slope' is the steepest ramp angle in degrees
    and 'surface' is a floor type from floors.yaml for the driving surface.
    The overpass spans 'deck_length / 2 + ramp_length' from its center each way,
    where ramp_length = height * pi / (2 * tan(max_slope)).

    The body mesh is assets/meshes/overpass_w<width>_h<height>_d<deck_length>_t<deck_thickness>_s<max_slope>.obj;
    there are meshes for the two sizes of the overpass world (wide and narrow).
  -->
  <xacro:macro name="overpass" params="name cx cy yaw style offsets surface:=asphalt height:=0.45 deck_length:=1.4 max_slope:=12
                                        width:=0.7 rails:=True marking_width:=0.05 deck_thickness:=0.05
                                        rail_height:=0.1 rail_width:=0.04 rail_pieces:=16">
    <xacro:property name="ramp_length" value="${height * pi / (2 * tan(radians(max_slope)))}"/>
    <xacro:property name="half" value="${deck_length / 2}"/>
    <xacro:property name="foot" value="${half + ramp_length}"/>
    <xacro:property name="rail_y" value="${(width - rail_width) / 2}"/>
    <xacro:property name="surface_cfg" value="${floors[surface]}"/>
    <xacro:property name="mesh"
        value="${meshes_dir}/overpass_w${'%g' % width}_h${'%g' % height}_d${'%g' % deck_length}_t${'%g' % deck_thickness}_s${'%g' % max_slope}.obj"/>
    <!-- Marking follows the ramp in pieces about 1 width long, so it stays on the curved surface. -->
    <xacro:property name="marking_pieces" value="${int(round(ramp_length / marking_width))}"/>

    <model name="${name}">
      <static>true</static>
      <pose>${cx} ${cy} 0 0 0 ${yaw}</pose>
      <link name="link">
        <collision name="body_collision">
          <geometry><mesh><uri>file://${mesh}</uri></mesh></geometry>
          <surface>
            <friction>
              <ode>
                <mu>${surface_cfg['mu']}</mu>
                <mu2>${surface_cfg['mu']}</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="body_visual">
          <geometry><mesh><uri>file://${mesh}</uri></mesh></geometry>
          <xacro:world_material color="${surface_cfg['color']}" texture="${surface_cfg['texture']}"/>
        </visual>

        <xacro:if value="${rails}">
          <xacro:solid_box name="deck_rail_left" x="0" y="${rail_y}" z="${height + rail_height / 2}"
              sx="${deck_length}" sy="${rail_width}" sz="${rail_height}" color="${rail_color}"/>
          <xacro:solid_box name="deck_rail_right" x="0" y="${-rail_y}" z="${height + rail_height / 2}"
              sx="${deck_length}" sy="${rail_width}" sz="${rail_height}" color="${rail_color}"/>
          <xacro:ramp_pieces name="ramp_in" k="0" n="${rail_pieces}" dir="-1" foot="${foot}" length="${ramp_length}" height="${height}"
              rails="True" rail_y="${rail_y}" rail_height="${rail_height}" rail_width="${rail_width}"/>
          <xacro:ramp_pieces name="ramp_out" k="0" n="${rail_pieces}" dir="1" foot="${foot}" length="${ramp_length}" height="${height}"
              rails="True" rail_y="${rail_y}" rail_height="${rail_height}" rail_width="${rail_width}"/>
        </xacro:if>

        <xacro:offset_marking_lines name="deck_marking" i="0" offsets="${offsets}" x1="${-half}" z1="${height}" x2="${half}" z2="${height}"
            style="${style}" width="${marking_width}"/>
        <xacro:ramp_pieces name="ramp_in" k="0" n="${marking_pieces}" dir="-1" foot="${foot}" length="${ramp_length}" height="${height}"
            offsets="${offsets}" style="${style}" marking_width="${marking_width}"/>
        <xacro:ramp_pieces name="ramp_out" k="0" n="${marking_pieces}" dir="1" foot="${foot}" length="${ramp_length}" height="${height}"
            offsets="${offsets}" style="${style}" marking_width="${marking_width}"/>
      </link>
    </model>
  </xacro:macro>

</sdf>
